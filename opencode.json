{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "control-chrome": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ],
      "enabled": false
    },
    "sqlite": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-sqlite",
        "--db-path",
        ".opencode/opencode.db"
      ],
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": false
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": false
    },
    "bocha-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@iflow-mcp/yoko19191-bocha-ai-mcp-server"
      ],
      "environment": {
        "BOCHA_API_KEY": "{env:BOCAI_API_KEY}",
        "BOCHA_API_URL": "{env:BOCAI_API_URL}",
        "BOCAI_API_KEY": "{env:BOCAI_API_KEY}",
        "BOCAI_API_URL": "{env:BOCAI_API_URL}"
      }
    },
    "ragflow": {
      "type": "remote",
      "url": "{env:RAGFLOW_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:RAGFLOW_API_KEY}"
      }
    }
  },
  "model": "my-company/MiniMax-2.5",
  "plugin": [
    "opencode-scheduler"
  ]
}

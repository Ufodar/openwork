{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "my-company": {
      "options": {
        "baseURL": "http://192.168.5.10:3002/v1",
        "apiKey": "sk-ICERFam8VpvQ3tsE3413B6B6Fc674966B1330cFaFbEd2836"
      },
      "models": {
        "Kimi-K2.5": {
          "name": "Kimi-K2.5",
          "modalities": {
            "input": [
              "text",
              "image",
              "audio",
              "video",
              "pdf"
            ],
            "output": [
              "text",
              "image"
            ]
          },
          "attachment": true,
          "interleaved": true,
          "tool_call": true
        },
        "GLM-5": {
          "name": "GLM-5",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": false,
          "tool_call": false
        }
      }
    }
  },
  "mcp": {
    "control-chrome": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/root/ai_staff/openwork"
      ]
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ],
      "enabled": false
    },
    "sqlite": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-sqlite",
        "--db-path",
        "/root/.config/opencode/mcp-global.db"
      ],
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": false
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": false
    },
    "bocha-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@iflow-mcp/yoko19191-bocha-ai-mcp-server"
      ],
      "environment": {
        "BOCHA_API_KEY": "{env:BOCAI_API_KEY}",
        "BOCHA_API_URL": "{env:BOCAI_API_URL}",
        "BOCAI_API_KEY": "{env:BOCAI_API_KEY}",
        "BOCAI_API_URL": "{env:BOCAI_API_URL}"
      }
    }
  },
  "model": "my-company/Kimi-K2.5",
  "plugin": [
    "opencode-scheduler"
  ]
}
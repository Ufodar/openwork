{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "agent": {
    "document-writer": {
      "description": "User-facing long-document controller that coordinates the doc-* workflow",
      "mode": "primary",
      "color": "#0EA5E9",
      "temperature": 0.1,
      "steps": 24,
      "prompt": "{file:./.opencode/agent/document-writer.md}",
      "tools": {
        "*": false,
        "task": true,
        "read": true,
        "doc_state_*": true,
        "state_get_*": true,
        "openwork_knowledge*": true,
        "openwork-knowledge*": true
      },
      "permission": {
        "task": "allow",
        "read": {
          "*": "deny",
          ".worktree/index.json": "allow",
          "**/.worktree/index.json": "allow",
          ".worktree/sources/manifest.json": "allow",
          "**/.worktree/sources/manifest.json": "allow",
          ".worktree/facts.json": "allow",
          "**/.worktree/facts.json": "allow",
          ".worktree/merge/conflicts.json": "allow",
          "**/.worktree/merge/conflicts.json": "allow",
          ".worktree/plan/solution-plan.json": "allow",
          "**/.worktree/plan/solution-plan.json": "allow",
          ".worktree/coverage.json": "allow",
          "**/.worktree/coverage.json": "allow",
          ".worktree/verify/coverage.json": "allow",
          "**/.worktree/verify/coverage.json": "allow",
          "requirements.csv": "allow",
          "**/requirements.csv": "allow",
          "reports/**": "allow",
          "**/reports/**": "allow"
        },
        "edit": "deny",
        "bash": "deny",
        "grep": "deny",
        "skill": {
          "*": "deny"
        }
      }
    },
    "common-work": {
      "description": "General-purpose OpenWork document agent that keeps raw OpenCode's default tool latitude while applying workspace-safe document guidance",
      "mode": "primary",
      "color": "#6366F1",
      "prompt": "{file:./.opencode/agent/common-work.md}",
      "permission": {
        "task": "allow",
        "read": {
          "*": "allow"
        },
        "write": {
          "*": "allow"
        },
        "edit": {
          "*": "allow"
        },
        "list": "allow",
        "glob": "allow",
        "bash": "allow",
        "grep": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "doc-intake": {
      "description": "Builds initial document-state artifacts from the current workspace without drafting the final deliverable",
      "mode": "subagent",
      "hidden": true,
      "color": "#1D4ED8",
      "temperature": 0.1,
      "steps": 24,
      "prompt": "{file:./.opencode/prompts/doc-intake.md}",
      "tools": {
        "*": false,
        "read": true,
        "list": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true
      },
      "permission": {
        "task": "deny",
        "read": {
          "*": "allow"
        },
        "list": "allow",
        "glob": "allow",
        "write": {
          "*": "deny",
          ".worktree/index.json": "allow",
          ".worktree/sources/manifest.json": "allow",
          ".worktree/conventions.md": "allow"
        },
        "edit": {
          "*": "deny",
          ".worktree/index.json": "allow",
          ".worktree/sources/manifest.json": "allow",
          ".worktree/conventions.md": "allow"
        },
        "bash": "allow"
      }
    },
    "doc-reader": {
      "description": "Compiles one source document into a structured document-state artifact with traceable claims and facts",
      "mode": "subagent",
      "hidden": true,
      "color": "#2563EB",
      "temperature": 0.1,
      "steps": 32,
      "prompt": "{file:./.opencode/prompts/doc-reader.md}",
      "tools": {
        "*": false,
        "read": true,
        "list": true,
        "glob": true,
        "bash": true,
        "skill": true
      },
      "permission": {
        "task": "deny",
        "read": {
          "*": "allow"
        },
        "list": "allow",
        "glob": "allow",
        "bash": "allow",
        "skill": {
          "*": "deny",
          "xlsx": "allow",
          "pptx": "allow"
        }
      }
    },
    "doc-merger": {
      "description": "Merges compiled source artifacts into canonical facts, conflicts, and durable task context",
      "mode": "subagent",
      "hidden": true,
      "color": "#0369A1",
      "temperature": 0.1,
      "steps": 20,
      "prompt": "{file:./.opencode/prompts/doc-merger.md}",
      "tools": {
        "*": false,
        "read": true,
        "list": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true
      },
      "permission": {
        "task": "deny",
        "read": {
          "*": "deny",
          ".worktree/index.json": "allow",
          ".worktree/sources/manifest.json": "allow",
          ".worktree/sources/*.json": "allow",
          "requirements.csv": "allow",
          "reports/**": "allow"
        },
        "list": {
          "*": "deny",
          ".worktree": "allow",
          ".worktree/**": "allow",
          "reports": "allow",
          "reports/**": "allow"
        },
        "glob": {
          "*": "deny",
          ".worktree/**": "allow",
          "reports/**": "allow"
        },
        "write": {
          "*": "deny",
          ".worktree/facts.json": "allow",
          ".worktree/merge/conflicts.json": "allow"
        },
        "edit": {
          "*": "deny",
          ".worktree/facts.json": "allow",
          ".worktree/merge/conflicts.json": "allow"
        },
        "bash": "allow"
      }
    },
    "doc-planner": {
      "description": "Turns canonical document state into a drafting and coverage plan for the target deliverable",
      "mode": "subagent",
      "hidden": true,
      "color": "#7C3AED",
      "temperature": 0.1,
      "steps": 20,
      "prompt": "{file:./.opencode/prompts/doc-planner.md}",
      "tools": {
        "*": false,
        "read": true,
        "list": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true
      },
      "permission": {
        "task": "deny",
        "read": {
          "*": "deny",
          ".worktree/index.json": "allow",
          "**/.worktree/index.json": "allow",
          ".worktree/sources/manifest.json": "allow",
          "**/.worktree/sources/manifest.json": "allow",
          ".worktree/facts.json": "allow",
          "**/.worktree/facts.json": "allow",
          ".worktree/merge/conflicts.json": "allow",
          "**/.worktree/merge/conflicts.json": "allow",
          ".worktree/plan/solution-plan.json": "allow",
          "**/.worktree/plan/solution-plan.json": "allow",
          ".worktree/coverage.json": "allow",
          "**/.worktree/coverage.json": "allow",
          "requirements.csv": "allow",
          "**/requirements.csv": "allow",
          "reports/**": "allow",
          "**/reports/**": "allow"
        },
        "list": {
          "*": "deny",
          ".worktree": "allow",
          ".worktree/**": "allow",
          "reports": "allow",
          "reports/**": "allow"
        },
        "glob": {
          "*": "deny",
          ".worktree/**": "allow",
          "reports/**": "allow"
        },
        "write": {
          "*": "deny",
          ".worktree/plan/solution-plan.json": "allow",
          ".worktree/coverage.json": "allow"
        },
        "edit": {
          "*": "deny",
          ".worktree/plan/solution-plan.json": "allow",
          ".worktree/coverage.json": "allow"
        },
        "bash": "allow"
      }
    },
    "doc-writer": {
      "description": "Drafts or revises the target document from the plan and evidence map, then updates coverage state",
      "mode": "subagent",
      "hidden": true,
      "color": "#B45309",
      "temperature": 0.2,
      "steps": 28,
      "prompt": "{file:./.opencode/prompts/doc-writer.md}",
      "tools": {
        "*": false,
        "read": true,
        "list": true,
        "glob": true,
        "write": true,
        "edit": true,
        "bash": true,
        "skill": false,
        "bocha-search*": true
      },
      "permission": {
        "task": "deny",
        "read": {
          "*": "deny",
          ".worktree/index.json": "allow",
          "**/.worktree/index.json": "allow",
          ".worktree/sources/manifest.json": "allow",
          "**/.worktree/sources/manifest.json": "allow",
          ".worktree/facts.json": "allow",
          "**/.worktree/facts.json": "allow",
          ".worktree/merge/conflicts.json": "allow",
          "**/.worktree/merge/conflicts.json": "allow",
          ".worktree/plan/solution-plan.json": "allow",
          "**/.worktree/plan/solution-plan.json": "allow",
          ".worktree/coverage.json": "allow",
          "**/.worktree/coverage.json": "allow",
          "outputs/**": "allow",
          "**/outputs/**": "allow",
          "*.md": "allow",
          "**/*.md": "allow",
          "*.doc": "allow",
          "**/*.doc": "allow",
          "*.docx": "allow",
          "**/*.docx": "allow"
        },
        "list": {
          "*": "allow"
        },
        "glob": {
          "*": "allow"
        },
        "write": {
          "*": "deny",
          "outputs/**": "allow",
          "**/outputs/**": "allow",
          "*.doc": "allow",
          "**/*.doc": "allow",
          "*.docx": "allow",
          "**/*.docx": "allow",
          "*.md": "allow",
          "**/*.md": "allow",
          ".worktree/coverage.json": "allow",
          "**/.worktree/coverage.json": "allow",
          "reports/doc-writer/**": "allow",
          "**/reports/doc-writer/**": "allow"
        },
        "edit": {
          "*": "deny",
          "outputs/**": "allow",
          "**/outputs/**": "allow",
          "*.doc": "allow",
          "**/*.doc": "allow",
          "*.docx": "allow",
          "**/*.docx": "allow",
          "*.md": "allow",
          "**/*.md": "allow",
          ".worktree/coverage.json": "allow",
          "**/.worktree/coverage.json": "allow",
          "reports/doc-writer/**": "allow",
          "**/reports/doc-writer/**": "allow"
        },
        "bash": "allow",
        "skill": {
          "*": "deny"
        }
      }
    },
    "doc-verifier": {
      "description": "Checks the drafted deliverable against plan and facts, then records coverage gaps and next actions",
      "mode": "subagent",
      "hidden": true,
      "color": "#BE123C",
      "temperature": 0.1,
      "steps": 24,
      "prompt": "{file:./.opencode/prompts/doc-verifier.md}",
      "tools": {
        "*": false,
        "read": true,
        "list": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true,
        "skill": true
      },
      "permission": {
        "task": "deny",
        "read": {
          "*": "deny",
          ".worktree/facts.json": "allow",
          "**/.worktree/facts.json": "allow",
          ".worktree/merge/conflicts.json": "allow",
          "**/.worktree/merge/conflicts.json": "allow",
          ".worktree/plan/solution-plan.json": "allow",
          "**/.worktree/plan/solution-plan.json": "allow",
          ".worktree/coverage.json": "allow",
          "**/.worktree/coverage.json": "allow",
          ".worktree/verify/coverage.json": "allow",
          "**/.worktree/verify/coverage.json": "allow",
          "outputs/**": "allow",
          "**/outputs/**": "allow",
          "*.md": "allow",
          "**/*.md": "allow",
          "*.doc": "allow",
          "**/*.doc": "allow",
          "*.docx": "allow",
          "**/*.docx": "allow"
        },
        "list": {
          "*": "allow"
        },
        "glob": {
          "*": "allow"
        },
        "write": {
          "*": "deny",
          ".worktree/verify/coverage.json": "allow",
          "**/.worktree/verify/coverage.json": "allow",
          "reports/doc-verifier/**": "allow",
          "**/reports/doc-verifier/**": "allow"
        },
        "edit": {
          "*": "deny",
          ".worktree/verify/coverage.json": "allow",
          "**/.worktree/verify/coverage.json": "allow",
          "reports/doc-verifier/**": "allow",
          "**/reports/doc-verifier/**": "allow"
        },
        "bash": "allow",
        "skill": {
          "*": "deny",
          "docx": "allow",
          "pdf": "allow",
          "xlsx": "allow",
          "pptx": "allow"
        }
      }
    }
  },
  "mcp": {
    "control-chrome": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ],
      "enabled": false
    },
    "sqlite": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-sqlite",
        "--db-path",
        ".opencode/opencode.db"
      ],
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": false
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": false
    },
    "bocha-search": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "{env:BOCHA_MCP_DIR}",
        "run",
        "bocha-search-mcp"
      ],
      "environment": {
        "BOCHA_API_KEY": "{env:BOCHA_API_KEY}"
      }
    },
    "ragflow": {
      "type": "remote",
      "url": "{env:RAGFLOW_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:RAGFLOW_API_KEY}"
      }
    }
  },
  "plugin": [
    "opencode-scheduler"
  ]
}

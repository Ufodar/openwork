# OpenWork runtime secrets example
# Copy to ~/.config/openwork/secrets.env on Pod and fill values.

export MY_COMPANY_API_KEY=""
export OPENWORK_PROVIDER_ID="my-company"
export OPENWORK_MODEL_BASE_URL="http://192.168.5.10:3002/v1"
# Supported values: Qwen3.5-397B-A17B, MiniMax-2.5
export OPENWORK_DEFAULT_MODEL="Qwen3.5-397B-A17B"
export OPENWORK_SMALL_MODEL="Qwen3.5-397B-A17B"
export BOCHA_API_KEY=""
export BOCHA_MCP_DIR="$HOME/.config/openwork/bocha-search-mcp"

# RAGFlow knowledge backend
export RAGFLOW_BASE_URL="http://192.168.2.35:32473"
export RAGFLOW_API_KEY=""
export RAGFLOW_MCP_URL="http://192.168.2.35:30467/sse"

# Optional
export BRAVE_API_KEY=""
export GITHUB_TOKEN=""

# Optional: non-interactive git pull on pod (used by restart-pod.sh --pull or OPENWORK_PULL_BEFORE_RESTART=1)
export OPENWORK_GIT_USERNAME=""
export OPENWORK_GIT_TOKEN=""

# Optional: set 1 to auto `git pull --ff-only` before restart-pod.sh starts services
export OPENWORK_PULL_BEFORE_RESTART="1"

# Optional: auto-clean common pod-local script edits before pull (default: 1)
export OPENWORK_AUTO_RESTORE_POD_LOCAL_CHANGES="1"

# Optional: npm mirror / package override for document tooling preinstall
export OPENWORK_NPM_REGISTRY=""
export OPENWORK_NODE_SKILL_PACKAGES=""

# Optional: network/runtime overrides (keep these in pod-local env, never in git)
export OPENWORK_POD_IP=""
export OPENWORK_PORT="8789"
export PORT="5173"
export OPENWORK_ONLYOFFICE_URL=""
export OPENWORK_ONLYOFFICE_INTERNAL_URL="http://onlyoffice:80"
export OPENWORK_ONLYOFFICE_PUBLIC_BASE_URL=""
